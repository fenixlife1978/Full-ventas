/**
 * @file firestore.rules
 * @description Firestore Security Rules for the application.
 *
 * @version 1.0
 *
 * @section Core Philosophy
 * This ruleset implements a public, append-only data model for reports and a
 * mutable model for products, sales and purchases. The core principle is that all reports are public
 * and can be read by anyone, including anonymous users. Authenticated users are
 * permitted to create new reports, but once a report is created, it is immutable
 * and cannot be updated or deleted by anyone. This ensures data integrity and
 * prevents tampering in an environment where documents do not have explicit owners.
 * Products, sales and purchases can be created, read, updated, and deleted by authenticated users.
 * Global settings are publicly readable to allow elements like the company logo to be
 * displayed on public-facing pages, but are only writable by authenticated users.
 *
 * @section Data Structure
 * The data is organized into four top-level collections:
 * - /reports/{reportId}: Stores individual report documents.
 * - /products/{productId}: Stores individual product documents.
 * - /sales/{saleId}: Stores individual sale documents.
 * - /purchases/{purchaseId}: Stores individual purchase documents.
 * - /settings/{settingId}: Stores global application settings.
 *
 * @section Key Security Decisions
 * - Public Read Access for Reports: All reports in the `/reports` collection are publicly readable
 *   to support application features that display report data to any user.
 * - Public Read Access for Settings: The `/settings` collection is publicly readable to allow
 *   the application to load configuration like the company logo on public pages (login, welcome).
 *   Write access is restricted to authenticated users.
 * - Authenticated CRUD for Products, Sales and Purchases: All operations on products, sales and purchases require authentication.
 * - Immutability for Reports: To prevent any user from modifying or deleting another user's report
 *   (especially since there is no `ownerId` field), all update and delete operations
 *   are explicitly denied for reports. This makes the `/reports` collection an append-only log.
 *
 * @section Denormalization for Authorization
 * This ruleset does not require denormalization as there are no ownership or role-based
 * access controls. The security model is intentionally simple, relying on authentication
 * status.
 *
 * @section Structural Segregation
 * Top-level collections are used because documents within them share
 * the same access level, making it efficient for list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * @description Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }


    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Allows public read access to all reports. Authenticated users can
     *   create new reports, but reports are immutable and cannot be
     *   updated or deleted.
     * @path /reports/{reportId}
     * @allow (get) Any user, signed-in or not, can read a specific report.
     * @allow (create) An authenticated user can create a new report document.
     * @deny (update) No user, even if authenticated, can update an existing report.
     * @deny (delete) No user can delete a report.
     * @principle Public read with authenticated-only creation. Reports are immutable to
     *   prevent data tampering in a multi-user environment that lacks explicit
     *   document ownership.
     */
    match /reports/{reportId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows authenticated users to manage products.
     * @path /products/{productId}
     * @allow (read, write) Any signed-in user can read, create, update, or delete product documents.
     */
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage sales.
     * @path /sales/{saleId}
     * @allow (read, write) Any signed-in user can read, create, update, or delete sale documents.
     */
    match /sales/{saleId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage purchases.
     * @path /purchases/{purchaseId}
     * @allow (read, write) Any signed-in user can read, create, update, or delete purchase documents.
     */
    match /purchases/{purchaseId} {
        allow read, write: if isSignedIn();
    }

     /**
     * @description Allows public read access to global settings, but write
     *   access is restricted to authenticated users. This is necessary for
     *   displaying elements like the company logo on public pages (e.g., login).
     * @path /settings/{settingId}
     * @allow (get, list) Any user, signed-in or not, can read settings.
     * @allow (write) Only an authenticated user can create, update, or delete settings.
     */
    match /settings/{settingId} {
        allow get, list: if true;
        allow write: if isSignedIn();
    }
  }
}
