{
  "entities": {
    "Reporte": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Reporte",
      "type": "object",
      "description": "Entidad que representa un reporte generado en la aplicación.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único del reporte."
        },
        "titulo": {
          "type": "string",
          "description": "Título del reporte."
        },
        "descripcion": {
          "type": "string",
          "description": "Descripción detallada del reporte."
        },
        "fechaCreacion": {
          "type": "string",
          "description": "Fecha y hora en que se generó el reporte.",
          "format": "date-time"
        },
        "formatoExportacion": {
          "type": "string",
          "description": "Formato en el que se exportará el reporte (PDF, CSV, etc.)."
        },
        "datos": {
          "type": "string",
          "description": "Datos asociados al reporte en formato JSON."
        }
      },
      "required": [
        "id",
        "titulo",
        "descripcion",
        "fechaCreacion",
        "formatoExportacion",
        "datos"
      ]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre del producto"
        },
        "description": {
          "type": "string",
          "description": "Descripción del producto"
        },
        "category": {
          "type": "string",
          "description": "Categoría del producto"
        },
        "price": {
          "type": "number",
          "description": "Precio de venta"
        },
        "cost": {
          "type": "number",
          "description": "Costo del producto"
        },
        "stock": {
          "type": "number",
          "description": "Cantidad en inventario"
        },
        "minStock": {
          "type": "number",
          "description": "Stock mínimo requerido"
        },
        "unit": {
          "type": "string",
          "description": "Unidad de medida (unidad, caja, kg, litro, etc.)"
        },
        "supplier": {
          "type": "string",
          "description": "Proveedor del producto"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ],
          "description": "Estado del producto"
        }
      },
      "required": [
        "name",
        "price",
        "stock"
      ]
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "ID del producto vendido"
        },
        "productName": {
          "type": "string",
          "description": "Nombre del producto"
        },
        "quantity": {
          "type": "number",
          "description": "Cantidad vendida"
        },
        "unitPrice": {
          "type": "number",
          "description": "Precio unitario al momento de la venta"
        },
        "totalAmount": {
          "type": "number",
          "description": "Monto total de la venta"
        },
        "saleDate": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de la venta"
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "cash",
            "card",
            "transfer",
            "other"
          ],
          "default": "cash",
          "description": "Método de pago"
        },
        "notes": {
          "type": "string",
          "description": "Notas adicionales sobre la venta"
        }
      },
      "required": [
        "productId",
        "productName",
        "quantity",
        "unitPrice",
        "totalAmount",
        "saleDate"
      ]
    },
    "Purchase": {
      "title": "Purchase",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "ID del producto comprado"
        },
        "productName": {
          "type": "string",
          "description": "Nombre del producto comprado"
        },
        "quantity": {
          "type": "number",
          "description": "Cantidad comprada"
        },
        "unitCost": {
          "type": "number",
          "description": "Costo unitario de compra"
        },
        "totalAmount": {
          "type": "number",
          "description": "Monto total de la compra"
        },
        "purchaseDate": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de la compra"
        },
        "supplier": {
          "type": "string",
          "description": "Proveedor de la compra"
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "Efectivo",
            "Tarjeta",
            "Transferencia",
            "Crédito"
          ],
          "description": "Método de pago utilizado"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Número de factura o documento"
        },
        "notes": {
          "type": "string",
          "description": "Notas adicionales sobre la compra"
        }
      },
      "required": [
        "productId",
        "productName",
        "quantity",
        "unitCost",
        "totalAmount",
        "purchaseDate",
        "supplier"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/reports/{reportId}",
        "definition": {
          "entityName": "Reporte",
          "schema": {
            "$ref": "#/backend/entities/Reporte"
          },
          "description": "Stores report data. 'reportId' is the unique identifier for the report.",
          "params": [
            {
              "name": "reportId",
              "description": "The unique identifier for the report."
            }
          ]
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Stores product data. 'productId' is the unique identifier for the product."
        }
      },
      {
        "path": "/sales/{saleId}",
        "definition": {
          "entityName": "Sale",
          "schema": {
            "$ref": "#/backend/entities/Sale"
          },
          "description": "Stores sale data. 'saleId' is the unique identifier for the sale."
        }
      },
      {
        "path": "/purchases/{purchaseId}",
        "definition": {
          "entityName": "Purchase",
          "schema": {
            "$ref": "#/backend/entities/Purchase"
          },
          "description": "Stores purchase data. 'purchaseId' is the unique identifier for the purchase."
        }
      }
    ],
    "reasoning": "The data structure is designed to store reports, products and sales generated within the application. Given that all users can create reports and that the application will generate dynamic reports based on AI processing, a top-level collection called 'reports' is used to store all report data. For products, a top-level 'products' collection is used for easy querying and management. For sales, a top-level 'sales' collection is appropriate for tracking all transactions. For purchases, a top-level 'purchases' collection is needed to track incoming inventory. No user-specific subcollections are created since there are no user-specific access controls mentioned.  Authorization independence is ensured as reports, products, sales and purchases don't have an owner id. This approach enables atomic creation and listing of reports, products, sales and purchases without relying on `get()` calls in the rules. Since the listing operation should be available for all users, the data segregation via top level collections enables that. This structure supports the QAPs, because all users can create and access the reports, products, sales and purchases, by storing every report in the same `reports` collection, every product in the `products` collection, every sale in the `sales` collection and every purchase in the `purchases` collection it is possible to create rules that validates the data integrity."
  }
}
    